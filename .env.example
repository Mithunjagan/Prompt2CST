# Provider credentials are backend process inputs. Never put them in QML,
# browser storage, logs, plans, or generated CST files.
OPENROUTER_API_KEY=
MODEL_PROVIDER=openrouter
MODEL_BASE_URL=https://openrouter.ai/api/v1

# A role may share a model with other roles.
MODEL_REQUIREMENTS=
MODEL_RF_REASONING=
MODEL_GEOMETRY=
MODEL_SIMULATION=
MODEL_CRITIC=
MODEL_CODE_REVIEW=
MODEL_RESULTS=

# Optional comma-separated fallback model IDs.
MODEL_REQUIREMENTS_FALLBACKS=
MODEL_RF_REASONING_FALLBACKS=
MODEL_GEOMETRY_FALLBACKS=
MODEL_SIMULATION_FALLBACKS=
MODEL_CRITIC_FALLBACKS=
MODEL_CODE_REVIEW_FALLBACKS=
MODEL_RESULTS_FALLBACKS=

MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_MAX_TOOL_CALLS=8
PROMPT2CST_MAX_SWEEP_CASES=200
PROMPT2CST_MAX_ESTIMATED_MESH_CELLS=100000
PROMPT2CST_OUTPUT_DIR=
PROMPT2CST_STATE_DIR=
PROMPT2CST_CST_PROGID=CSTStudio.Application.2026
